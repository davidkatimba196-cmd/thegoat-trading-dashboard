:root {
  --background: #050d1a;
  --background-strong: #091426;
  --background-soft: #0b1323;
  --panel: rgba(10, 18, 31, 0.94);
  --panel-strong: #111e2f;
  --panel-elevated: #0d1a2b;
  --panel-muted: rgba(17, 30, 47, 0.8);
  --border: rgba(148, 163, 184, 0.15);
  --border-strong: rgba(96, 165, 250, 0.24);
  --text: #ecf4ff;
  --text-muted: #9aa9bf;
  --text-soft: #7c8da8;
  --blue: #4ea5ff;
  --blue-strong: #1f85ff;
  --blue-soft: rgba(78, 165, 255, 0.12);
  --cyan: #6ae2ff;
  --shadow: 0 24px 54px rgba(2, 6, 18, 0.52);
  --shadow-soft: 0 16px 32px rgba(12, 21, 34, 0.42);
  --radius-xl: 28px;
  --radius-lg: 20px;
  --radius-md: 14px;
  --radius-sm: 12px;
  --transition: 180ms ease;
}

* {
  box-sizing: border-box;
}

html {
  color-scheme: dark;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, 'Segoe UI', sans-serif;
  background:
    radial-gradient(circle at top, rgba(30, 91, 179, 0.16), transparent 35%),
    linear-gradient(180deg, #050d1a 0%, #091421 100%);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  border: 0;
  border-radius: 999px;
  background: none;
  color: inherit;
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition), background var(--transition);
}

button:focus-visible,
a:focus-visible {
  outline: 2px solid rgba(94, 170, 255, 0.8);
  outline-offset: 3px;
}

.page-shell {
  width: min(1230px, calc(100% - 28px));
  margin: 28px auto 40px;
  padding: 20px 18px 28px;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18px;
  height: 76px;
  padding: 14px 18px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: rgba(11, 18, 31, 0.8);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(10px);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-width: 160px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 12px;
  background: linear-gradient(180deg, rgba(78, 165, 255, 0.24), rgba(78, 165, 255, 0.06));
  border: 1px solid var(--border-strong);
  color: var(--blue);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
}

.brand-name {
  font-size: 0.78rem;
  letter-spacing: 0.18em;
}

.status-indicator {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  border: 1px solid rgba(74, 222, 128, 0.22);
  background: rgba(26, 41, 30, 0.7);
  color: #c8f3d8;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.status-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #7ae4a0;
  box-shadow: 0 0 12px rgba(122, 228, 160, 0.8);
}

.status-dot.active {
  background: #7ae4a0;
}

.topnav {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-left: auto;
  color: var(--text-muted);
  font-size: 0.82rem;
}

.topnav a {
  position: relative;
  opacity: 0.86;
  transition: color var(--transition);
}

.topnav a:hover,
.topnav a:focus-visible {
  color: var(--text);
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: 12px;
}

.toolbar-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 42px;
  height: 42px;
  border: 1px solid var(--border);
  background: rgba(17, 26, 40, 0.85);
  color: var(--text);
}

.toolbar-button.tertiary {
  min-width: 88px;
  padding: 0 16px;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.toolbar-button svg {
  width: 18px;
  height: 18px;
}

.toolbar-button:hover,
.toolbar-button:focus-visible {
  border-color: rgba(94, 170, 255, 0.4);
  box-shadow: 0 0 0 1px rgba(94, 170, 255, 0.2);
}

.page-content {
  padding-top: 30px;
}

.hero-panel {
  display: grid;
  grid-template-columns: 1.6fr 0.9fr;
  gap: 22px;
  padding: 30px 30px 24px;
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  background: rgba(16, 25, 39, 0.9);
  box-shadow: var(--shadow-soft);
}

.hero-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8px 0 4px;
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--blue);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 600;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  max-width: 620px;
  margin-bottom: 16px;
  font-size: clamp(2.4rem, 4vw, 4.2rem);
  line-height: 1.02;
  letter-spacing: -0.06em;
}

.hero-description {
  max-width: 620px;
  margin-bottom: 26px;
  color: var(--text-muted);
  font-size: 1rem;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.primary-button,
.secondary-button,
.card-action {
  min-height: 46px;
  padding: 0 20px;
  border-radius: 12px;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.primary-button {
  background: linear-gradient(180deg, #1f8dff 0%, #1568d9 100%);
  color: #eef8ff;
  box-shadow: 0 0 0 1px rgba(105, 168, 255, 0.2), 0 12px 28px rgba(31, 115, 255, 0.35);
}

.primary-button:hover,
.primary-button:focus-visible {
  transform: translateY(-1px);
  box-shadow: 0 0 0 1px rgba(105, 168, 255, 0.3), 0 16px 30px rgba(31, 115, 255, 0.42);
}

.secondary-button {
  background: rgba(15, 24, 38, 0.7);
  color: var(--text);
  border: 1px solid var(--border);
}

.secondary-button:hover,
.secondary-button:focus-visible {
  border-color: rgba(94, 170, 255, 0.35);
}

.hero-summary {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24px 22px 20px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: linear-gradient(180deg, rgba(14, 24, 39, 0.96), rgba(9, 16, 27, 0.96));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
}

.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
  color: var(--text-muted);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.summary-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.7rem;
  letter-spacing: 0.04em;
}

.summary-tag.positive {
  background: rgba(39, 150, 96, 0.15);
  color: #9ce6bc;
}

.market-stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.market-row {
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: 10px;
  padding: 14px 14px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: rgba(12, 20, 32, 0.8);
}

.market-row span {
  color: var(--text-muted);
  font-size: 0.8rem;
}

.market-row strong {
  font-size: 1.02rem;
}

.market-row em {
  color: #9ce6bc;
  font-style: normal;
  font-size: 0.75rem;
  letter-spacing: 0.04em;
}

.summary-footer {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 18px;
}

.summary-footer div {
  padding: 16px 14px 0;
  border-top: 1px solid var(--border);
}

.summary-footer label {
  display: block;
  margin-bottom: 6px;
  color: var(--text-soft);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.summary-footer strong {
  font-size: 1.45rem;
  line-height: 1;
}

.setup-panel,
.tools-panel {
  margin-top: 28px;
  padding: 24px 22px 18px;
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  background: rgba(12, 20, 32, 0.9);
  box-shadow: var(--shadow-soft);
}

.panel-header,
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.panel-header h2,
.section-heading h2 {
  margin-bottom: 0;
  font-size: clamp(1.4rem, 2vw, 2.1rem);
  letter-spacing: -0.05em;
}

.connection-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border: 1px solid rgba(122, 228, 160, 0.2);
  border-radius: 999px;
  background: rgba(26, 41, 30, 0.7);
  color: #c7f1d4;
  font-size: 0.75rem;
  letter-spacing: 0.04em;
}

.stepper {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-top: 22px;
}

.step {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  min-height: 110px;
  padding: 18px 14px 16px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: rgba(11, 18, 30, 0.7);
}

.step.is-active {
  border-color: rgba(94, 170, 255, 0.35);
  background: linear-gradient(180deg, rgba(17, 30, 46, 0.96), rgba(11, 17, 27, 0.9));
  box-shadow: inset 0 0 0 1px rgba(94, 170, 255, 0.12);
}

.step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 10px;
  background: rgba(78, 165, 255, 0.12);
  color: var(--blue);
  border: 1px solid rgba(94, 170, 255, 0.2);
  font-size: 0.8rem;
  font-weight: 700;
}

.step strong {
  display: block;
  margin-bottom: 6px;
  font-size: 0.95rem;
  line-height: 1.3;
}

.step small {
  display: block;
  color: var(--text-muted);
  line-height: 1.5;
  font-size: 0.72rem;
}

.progress-block {
  margin-top: 20px;
  padding-top: 8px;
}

.progress-track {
  position: relative;
  width: 100%;
  height: 10px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.12);
  overflow: hidden;
}

.progress-fill {
  position: absolute;
  inset: 0 auto 0 0;
  width: 72%;
  border-radius: inherit;
  background: linear-gradient(90deg, rgba(78, 165, 255, 0.8), rgba(106, 226, 255, 0.96));
  box-shadow: 0 0 18px rgba(78, 165, 255, 0.45);
  animation: pulseFill 1800ms ease-in-out infinite alternate;
}

@keyframes pulseFill {
  from {
    opacity: 0.9;
  }
  to {
    opacity: 1;
  }
}

.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  color: var(--text-muted);
  font-size: 0.8rem;
}

.progress-meta strong {
  font-size: 0.9rem;
  color: var(--text);
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-top: 18px;
}

.tool-card {
  display: flex;
  flex-direction: column;
  min-height: 260px;
  padding: 18px 18px 16px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: rgba(13, 22, 34, 0.86);
  transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
}

.tool-card:hover,
.tool-card:focus-within {
  transform: translateY(-2px);
  border-color: rgba(94, 170, 255, 0.28);
  box-shadow: 0 16px 28px rgba(8, 14, 25, 0.42);
}

.card-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: rgba(78, 165, 255, 0.12);
  border: 1px solid rgba(94, 170, 255, 0.2);
  color: var(--blue);
  margin-bottom: 16px;
}

.card-icon svg {
  width: 22px;
  height: 22px;
}

.card-content {
  flex: 1;
}

.card-content h3 {
  margin-bottom: 10px;
  font-size: 1.1rem;
  letter-spacing: -0.03em;
}

.card-content p {
  margin-bottom: 0;
  color: var(--text-muted);
  line-height: 1.7;
  font-size: 0.92rem;
}

.card-action {
  width: 100%;
  margin-top: 18px;
  padding-inline: 16px;
  background: rgba(16, 25, 38, 0.8);
  border: 1px solid var(--border);
  color: var(--text);
  font-size: 0.8rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.card-action:hover,
.card-action:focus-visible {
  border-color: rgba(94, 170, 255, 0.38);
  background: rgba(15, 27, 41, 0.9);
}

@media (max-width: 980px) {
  .hero-panel {
    grid-template-columns: 1fr;
  }

  .stepper,
  .tool-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .page-shell {
    width: min(100% - 18px, 100%);
    margin-top: 18px;
  }

  .topbar {
    flex-wrap: wrap;
    height: auto;
    padding: 12px 14px;
  }

  .topnav {
    order: 3;
    width: 100%;
    justify-content: space-between;
    gap: 10px;
    margin-left: 0;
    padding-top: 10px;
    font-size: 0.72rem;
  }

  .toolbar {
    margin-left: auto;
  }

  .hero-panel,
  .setup-panel,
  .tools-panel {
    padding-left: 18px;
    padding-right: 18px;
  }

  .stepper,
  .tool-grid {
    grid-template-columns: 1fr;
  }

  .brand-name {
    letter-spacing: 0.12em;
  }

  .summary-footer {
    grid-template-columns: 1fr;
  }

  .panel-header,
  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }
}
